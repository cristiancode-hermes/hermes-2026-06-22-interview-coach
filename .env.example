# Database (SQLite for dev, PostgreSQL/Neon for prod)
DATABASE_URL=data/interview-coach.db

# JWT Secret (change in production)
JWT_SECRET=change-me-in-production

# OpenAI API Key (optional — leave empty to use local fallback analysis)
OPENAI_API_KEY=

# Neon PostgreSQL (optional — for production)
NEON_API_KEY=

# App
PORT=3000
